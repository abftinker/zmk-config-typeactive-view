#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LEFT_SHIFT  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL       &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                              &kp LGUI  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp RALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6    &kp NUMBER_7  &kp NUMBER_8    &kp NUMBER_9  &kp NUMBER_0      &kp DEL            &kp BSPC
&kp LEFT_SHIFT  &trans        &trans        &trans        &trans        &trans          &kp GRAVE     &kp MINUS       &kp PLUS      &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp BACKSLASH
&kp LCTRL       &trans        &trans        &trans        &trans        &trans          &kp TILDE     &kp UNDERSCORE  &kp EQUAL     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PIPE
                                            &kp LGUI      &trans        &kp SPACE       &kp RET       &trans          &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&kp F1      &kp F2            &kp F3          &kp F4           &kp F5  &kp F6       &kp F7       &kp F8          &kp F9        &kp F10    &kp F11  &kp F12
&kp LSHIFT  &kp K_MUTE        &kp C_VOL_DN    &kp C_VOLUME_UP  &trans  &trans       &kp LEFT     &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &trans   &kp HOME
&kp LCTRL   &kp K_PLAY_PAUSE  &kp C_PREVIOUS  &kp C_NEXT       &trans  &trans       &kp PAGE_UP  &kp PAGE_DOWN   &trans        &trans     &trans   &kp END
                                              &kp LGUI         &trans  &kp SPACE    &kp RET      &trans          &kp RALT
            >;
        };

        deep_layer {
            display-name = "Lower";
            bindings = <
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)  &kp LS(NUMBER_6)    &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp LS(NUMBER_0)  &kp DEL  &kp BSPC
&trans            &bt BT_SEL 0      &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3      &bt BT_SEL 4        &bt BT_CLR        &trans            &trans            &trans            &trans   &bt BT_CLR_ALL
&kp LS(CAPS)      &trans            &trans            &trans            &kp LC(LS(C))     &trans              &trans            &kp LC(LS(V))     &trans            &trans            &trans   &trans
                                                      &kp LGUI          &trans            &kp SPACE           &kp RET           &trans            &kp RALT
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Combine {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
